# ── Site ────────────────────────────────────────────────────────────────
# Canonical public origin. REQUIRED in production: PayPal return/cancel URLs
# and payment redirects are built only from this (never from request headers).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (client SDK, public) ───────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only, SECRET) ────────────────────────────────
# Service-account JSON (Firebase console → Project settings → Service accounts
# → Generate new private key), either raw on one line or base64-encoded.
# If unset, Google Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT=

# ── PayPal (server only, SECRET) ────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Exactly "live" or "sandbox". In production anything but "live" is refused
# unless PAYPAL_ALLOW_SANDBOX=true (staging deployments only).
PAYPAL_MODE=sandbox
PAYPAL_ALLOW_SANDBOX=
# Webhook ID from the PayPal app's Webhooks section (signature verification).
PAYPAL_WEBHOOK_ID=
# Optional: your PayPal merchant (payer) ID. When set, captures paid to any
# other merchant are refused and refunded.
PAYPAL_MERCHANT_ID=

# ── Analytics / ads (optional, public) ──────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=

# Admins are no longer configured by email env vars — grant the Firebase
# custom claim instead:  npm run set-admin -- you@example.com
