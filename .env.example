# ── Site ────────────────────────────────────────────────────────────────
# Canonical public origin. REQUIRED in production: PayPal return/cancel URLs
# and payment redirects are built only from this (never from request headers).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (client SDK, public) ───────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only, SECRET) ────────────────────────────────
# Service-account JSON (Firebase console → Project settings → Service accounts
# → Generate new private key), either raw on one line or base64-encoded.
# If unset, Google Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT=

# ── PayPal (server only, SECRET) ────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Exactly "live" or "sandbox". In production anything but "live" is refused
# unless PAYPAL_ALLOW_SANDBOX=true (staging deployments only).
PAYPAL_MODE=sandbox
PAYPAL_ALLOW_SANDBOX=
# Webhook ID from the PayPal app's Webhooks section (signature verification).
PAYPAL_WEBHOOK_ID=
# Optional: your PayPal merchant (payer) ID. When set, captures paid to any
# other merchant are refused and refunded.
PAYPAL_MERCHANT_ID=

# ── Creator marketplace: Stripe Connect (server only, SECRET) ──────────
# Creator hunts are paid with Stripe Checkout; the creator's share is sent to
# their Stripe Express account. House hunts and hint credits stay on PayPal.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# charge.refunded, charge.dispute.closed).
STRIPE_WEBHOOK_SECRET=
# Signing secret of the "connected accounts" endpoint (same URL, event
# account.updated). Leave empty if one endpoint handles both.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Staging only: allow an sk_test_ key on a production build.
STRIPE_ALLOW_TEST=

# Sale split (basis points). Defaults: 20% commission on the price excl. VAT,
# 3% payment fee on the price paid, 21% VAT.
PLATFORM_COMMISSION_BPS=2000
PAYMENT_FEE_BPS=300
VAT_RATE_BPS=2100

# ── Creator marketplace: translation + email (server only, SECRET) ──────
# Claude translates approved creator hunts into the other five languages.
ANTHROPIC_API_KEY=
# Resend (https://resend.com) for review/sale emails. Without a key emails are
# only logged. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=TourHunts <hello@tourhunts.com>
ADMIN_NOTIFY_EMAIL=

# ── Analytics / ads (optional, public) ──────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=

# Admins are no longer configured by email env vars — grant the Firebase
# custom claim instead:  npm run set-admin -- you@example.com
