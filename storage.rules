rules_version = '2';

// Firebase Storage: only creators' own uploads (cover photos) — deny everything else.
// A signed-in, non-anonymous user may write images (≤ 5 MB) under creators/{their uid}/.
// Files are publicly readable so published hunts can show their cover.
service firebase.storage {
  match /b/{bucket}/o {
    match /creators/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
